{"openapi":"3.0.1","info":{"title":"Banking Product & Pricing REST API","description":"Backend APIs for Banking Lab L5 (Product & Pricing), Lab L9 (JWT Security), and Lab L13 (FD Account Integration). Defines banking products, encapsulates business limits and rate formulas, and exposes integration endpoints for FD creation.","contact":{"name":"Banking Tech Team","email":"banking-tech@bank.com"},"license":{"name":"Apache 2.0","url":"https://springdoc.org"},"version":"1.0.0"},"servers":[{"url":"http://localhost","description":"Generated server url"}],"security":[{"BearerAuthentication":[]}],"tags":[{"name":"Authentication Helper API","description":"Endpoints for generating mock/test JWT tokens with role claims."},{"name":"FD Calculator API","description":"Endpoints for computing Fixed Deposit maturity interest amounts and listing rate variation categories."},{"name":"Banking Product API","description":"Endpoints for creating, maintaining, and integrating banking products (FD, CASA, Loans)."}],"paths":{"/api/product/{productCode}":{"get":{"tags":["Banking Product API"],"summary":"Get a banking product by its unique code","description":"Requires BANK_OFFICER or ADMIN role. Retrieves complete specifications of a banking product.","operationId":"getProductByCode","parameters":[{"name":"productCode","in":"path","description":"Unique code of the product to fetch","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Product found and returned","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProductResponseDTO"}}}},"404":{"description":"Product not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorDetails"}}}}},"security":[{"BearerAuthentication":[]}]},"put":{"tags":["Banking Product API"],"summary":"Update an existing banking product","description":"Requires BANK_OFFICER or ADMIN role. Updates product specifications.","operationId":"updateProduct","parameters":[{"name":"productCode","in":"path","description":"Unique code