{
  "info": {
    "_postman_id": "c1f73602-0e27-4a0b-9df0-7d39ba944ef0",
    "name": "Banking Product & Pricing API (Labs L5, L9, L13)",
    "description": "Comprehensive Postman collection for Product & Pricing Backend Module covering JWT Role Authorization, CRUD operations, Business Rules Validation, and FD Module Integration.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "officerToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication & Tokens (Lab L9)",
      "item": [
        {
          "name": "Generate Admin Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('adminToken', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"bank_admin\",\n  \"roles\": [\"ADMIN\", \"BANK_OFFICER\"]\n}"
            },
            "url": "{{baseUrl}}/api/auth/token"
          }
        },
        {
          "name": "Generate Bank Officer Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('officerToken', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"bank_officer\",\n  \"roles\": [\"BANK_OFFICER\"]\n}"
            },
            "url": "{{baseUrl}}/api/auth/token"
          }
        }
      ]
    },
    {
      "name": "2. Product Management (Lab L5)",
      "item": [
        {
          "name": "Create Product - Success (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productCode\": \"FD101\",\n  \"productName\": \"Fixed Deposit - Multi Year Growth\",\n  \"productType\": \"FD\",\n  \"currency\": \"INR\",\n  \"effectiveDate\": \"2025-07-01\",\n  \"status\": \"ACTIVE\",\n  \"termLimit\": { \"min\": 6, \"max\": 60 },\n  \"rateLimit\": { \"min\": 6.0, \"max\": 8.5 },\n  \"interestType\": \"CREDIT\",\n  \"minAge\": 18,\n  \"minDeposit\": 10000.0,\n  \"maxDeposit\": 5000000.0,\n  \"charges\": {\n    \"interestCreditFrequency\": \"QUARTERLY\",\n    \"taxDeduction\": true,\n    \"withdrawalFees\": 1.0\n  },\n  \"allowedRoles\": [\"OWNER\", \"CO_OWNER\", \"NOMINEE\"],\n  \"rateVariations\": [\n    { \"customerCategory\": \"SENIOR_CITIZEN\", \"rateModifier\": 0.75 },\n    { \"customerCategory\": \"EMPLOYEE\", \"rateModifier\": 0.50 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/product"
          }
        },
        {
          "name": "Get Product by Code",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{officerToken}}" }
            ],
            "url": "{{baseUrl}}/api/product/FD101"
          }
        },
        {
          "name": "Search Products with Pagination",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{officerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/product/search?productType=FD&startDate=2025-01-01&endDate=2025-12-31&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "product", "search"],
              "query": [
                { "key": "productType", "value": "FD" },
                { "key": "startDate", "value": "2025-01-01" },
                { "key": "endDate", "value": "2025-12-31" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Update Product - Success (Officer/Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{officerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productCode\": \"FD101\",\n  \"productName\": \"Fixed Deposit - Premium Growth\",\n  \"productType\": \"FD\",\n  \"currency\": \"INR\",\n  \"status\": \"ACTIVE\",\n  \"rateLimit\": { \"min\": 6.25, \"max\": 8.75 }\n}"
            },
            "url": "{{baseUrl}}/api/product/FD101"
          }
        },
        {
          "name": "Retire Product - Soft Delete (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/api/product/FD101"
          }
        }
      ]
    },
    {
      "name": "3. FD Integration APIs (Lab L13)",
      "item": [
        {
          "name": "Validate Product - Success",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{officerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/product/FD001/validate?termMonths=12&amount=50000&age=35",
              "host": ["{{baseUrl}}"],
              "path": ["api", "product", "FD001", "validate"],
              "query": [
                { "key": "termMonths", "value": "12" },
                { "key": "amount", "value": "50000" },
                { "key": "age", "value": "35" }
              ]
            }
          }
        },
        {
          "name": "Calculate Final Interest Rate (Category Bonus & Clamping)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{officerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"termMonths\": 12,\n  \"customerCategory\": \"SENIOR_CITIZEN\",\n  \"age\": 65\n}"
            },
            "url": "{{baseUrl}}/api/product/FD001/rate"
          }
        },
        {
          "name": "List Active Products (Dropdown Feed)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{officerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/product/active?type=FD",
              "host": ["{{baseUrl}}"],
              "path": ["api", "product", "active"],
              "query": [
                { "key": "type", "value": "FD" }
              ]
            }
          }
        },
        {
          "name": "Get Product Account Defaults",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{officerToken}}" }
            ],
            "url": "{{baseUrl}}/api/product/FD001/defaults"
          }
        }
      ]
    },
    {
      "name": "4. Error Validation Cases (Security & Business Rules)",
      "item": [
        {
          "name": "401 Unauthorized - Missing Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/product/search"
          }
        },
        {
          "name": "403 Forbidden - Bank Officer Creating Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{officerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productCode\": \"FD999\",\n  \"productName\": \"Forbidden Create\",\n  \"productType\": \"FD\",\n  \"currency\": \"INR\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/api/product"
          }
        },
        {
          "name": "409 Conflict - Duplicate Product Code",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productCode\": \"FD001\",\n  \"productName\": \"Duplicate Short Term FD\",\n  \"productType\": \"FD\",\n  \"currency\": \"INR\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/api/product"
          }
        },
        {
          "name": "400 Bad Request - Min Rate > Max Rate",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productCode\": \"FD001\",\n  \"productName\": \"Invalid Interest Range\",\n  \"productType\": \"FD\",\n  \"currency\": \"INR\",\n  \"status\": \"ACTIVE\",\n  \"rateLimit\": { \"min\": 9.5, \"max\": 6.0 }\n}"
            },
            "url": "{{baseUrl}}/api/product/FD001"
          }
        },
        {
          "name": "404 Not Found - Unknown Product Code",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{officerToken}}" }
            ],
            "url": "{{baseUrl}}/api/product/UNKNOWN999"
          }
        },
        {
          "name": "422 Unprocessable - Validate Inactive/Retired Product",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{officerToken}}" }
            ],
            "url": "{{baseUrl}}/api/product/FD101/validate?termMonths=12"
          }
        }
      ]
    },
    {
      "name": "5. Observability (Actuator)",
      "item": [
        {
          "name": "Actuator Health Check (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health"
          }
        }
      ]
    }
  ]
}
