# Copy these settings into the root .env file, retaining existing JWT/database values.
# Leave relay disabled until your authenticated SMTP sender is configured.
SMTP_RELAY_ENABLED=false
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=587
SMTP_RELAY_STARTTLS=true
SMTP_RELAY_AUTH=plain
SMTP_RELAY_USERNAME=
SMTP_RELAY_PASSWORD=
NOTIFY_EMAIL_FROM=noreply@fd-bank.local
NOTIFY_WHATSAPP_MOCK_ONLY=true
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Approved utility template with variables {{1}} = subject and {{2}} = message.
TWILIO_WHATSAPP_CONTENT_SID=
