# Copy to scripts/local.env.ps1 and edit for your existing local MySQL installation.
# This file is loaded only by start-services.ps1. Do not commit local.env.ps1.
$env:DB_USER='root'
$env:DB_PASSWORD='CHANGE_ME'
$env:FD_DB_URL='jdbc:mysql://localhost:3306/banking_technology_lab?serverTimezone=Asia/Kolkata'
$env:BATCH_DB_URL='jdbc:mysql://localhost:3306/fd_batch?serverTimezone=Asia/Kolkata'
$env:STATEMENT_DB_URL='jdbc:mysql://localhost:3306/fd_statements?serverTimezone=Asia/Kolkata'
$env:KAFKA_BOOTSTRAP_SERVERS='localhost:9092'
$env:NOTIFY_DB_URL='jdbc:mysql://localhost:3306/fd_notifications?serverTimezone=Asia/Kolkata'
# Time travel for demos/tests (L20). Leave these out in production.
$env:APP_TIME_TRAVEL_ENABLED='true'
$env:APP_TIME_TRAVEL_MAX_DAYS_AHEAD='400'
# Real e-mail (optional). Without SPRING_MAIL_HOST the service only logs [MOCK EMAIL].
# Gmail: enable 2-step verification, create an App Password, and use it below (NOT your normal password).
#$env:SPRING_MAIL_HOST='smtp.gmail.com'
#$env:SPRING_MAIL_PORT='587'
#$env:SPRING_MAIL_USERNAME='you@gmail.com'
#$env:SPRING_MAIL_PASSWORD='your-16-char-app-password'
#$env:SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH='true'
#$env:SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE='true'
#$env:NOTIFY_EMAIL_FROM='you@gmail.com'
# JWT login (auth-service issues tokens, every service validates them). Use a long random string (32+ characters); never commit it.
# Generate one:  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | ForEach-Object { [char]$_ })
$env:JWT_SECRET='CHANGE_ME_TO_A_RANDOM_STRING_OF_AT_LEAST_32_CHARACTERS'
# Accept only JWT tokens (turn the Basic demo logins off):
#$env:APP_SECURITY_BASIC_ENABLED='false'
# WhatsApp alerts (optional, free): Twilio WhatsApp sandbox. Without these two values WhatsApp runs in MOCK mode.
# 1) Create a free Twilio account, open Messaging > Try it out > Send a WhatsApp message, 2) from your phone send the shown 'join <words>' message to the sandbox number.
#$env:TWILIO_SID='ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'
#$env:TWILIO_TOKEN='your-twilio-auth-token'
# Set the customer's phone (use your own, with country code):  UPDATE customer_profile SET phone='+919876543210' WHERE customer_id='CUST001';
